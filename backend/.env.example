# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=talentsphere
DB_USER=postgres
DB_PASSWORD=

# Set to true in development to auto-create/alter tables from the models.
DB_SYNC=true

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1d

# SMTP for password-reset emails. Leave blank in development and the reset
# link is printed to the server console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@talentsphere.ai
